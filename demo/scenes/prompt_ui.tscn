[gd_scene load_steps=2 format=3 uid="uid://promptui"]

[ext_resource type="Script" path="res://scripts/prompt_ui.gd" id="1_script"]

[node name="PromptUI" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
anchors_preset = 3
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -150.0
offset_right = 200.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="VBoxContainer"]
custom_minimum_size = Vector2(400, 300)
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="MarginContainer" type="MarginContainer" parent="VBoxContainer/Panel"]
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="VBoxContainer/Panel/MarginContainer"]
layout_mode = 2

[node name="Title" type="Label" parent="VBoxContainer/Panel/MarginContainer/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 1, 0, 1)
theme_override_font_sizes/font_size = 14
text = "AI COMMAND INTERFACE"
horizontal_alignment = 1

[node name="HSep" type="HSeparator" parent="VBoxContainer/Panel/MarginContainer/VBox"]
layout_mode = 2

[node name="Output" type="RichTextLabel" parent="VBoxContainer/Panel/MarginContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0.8, 0, 1)
theme_override_font_sizes/normal_font_size = 12
text = "Type 'help' for commands"
scroll_following = true

[node name="HSep2" type="HSeparator" parent="VBoxContainer/Panel/MarginContainer/VBox"]
layout_mode = 2

[node name="Input" type="LineEdit" parent="VBoxContainer/Panel/MarginContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Enter command..."
placeholder_text_color = Color(0.5, 0.5, 0.5, 1)
caret_blink = true
